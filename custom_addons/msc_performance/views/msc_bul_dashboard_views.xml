<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ── Dashboard line inline view ───────────────────────────────────── -->
    <record id="view_msc_bul_dashboard_line_list" model="ir.ui.view">
        <field name="name">msc.bul.dashboard.line.list</field>
        <field name="model">msc.bul.dashboard.line</field>
        <field name="arch" type="xml">
            <list string="Xếp loại theo bộ phận" create="0" delete="0" >
                <field name="department_name" string="Bộ phận"/>
                <field name="performance_result" string="Performance Result"
                       widget="badge"
                       decoration-success="performance_result in ('a_plus', 'a')"
                       decoration-info="performance_result == 'b'"
                       decoration-warning="performance_result == 'c'"
                       decoration-danger="performance_result == 'd'"/>
                <field name="count" string="Tổng số"/>
                <field name="percentage" string="Tỷ lệ" widget="percentage"/>
            </list>
        </field>
    </record>

    <!-- ── Pending list inline view ─────────────────────────────────────── -->
    <record id="view_msc_bul_dashboard_pending_list" model="ir.ui.view">
        <field name="name">msc.bul.dashboard.pending.list</field>
        <field name="model">msc.bul.dashboard.pending</field>
        <field name="arch" type="xml">
            <list string="Danh sách MSC chờ phê duyệt" create="0" delete="0" >
                <field name="employee_id" string="Nhân viên"/>
                <field name="department_id" string="Bộ phận"/>
                <field name="report_to_id" string="Quản lý"/>
                <field name="total_score" string="Tổng điểm"/>
                <field name="performance_rating" string="Xếp loại tạm thời"
                       widget="badge"
                       decoration-success="performance_rating in ('a_plus', 'a')"
                       decoration-info="performance_rating == 'b'"
                       decoration-warning="performance_rating == 'c'"
                       decoration-danger="performance_rating == 'd'"/>
            </list>
        </field>
    </record>

    <!-- ── Dashboard form ───────────────────────────────────────────────── -->
    <record id="view_msc_bul_dashboard_form" model="ir.ui.view">
        <field name="name">msc.bul.dashboard.form</field>
        <field name="model">msc.bul.dashboard</field>
        <field name="arch" type="xml">
            <form string="Bảng đánh giá xếp loại bộ phận">
                <header>
                    <button name="action_compute" string="Xem báo cáo" type="object"
                            class="btn-primary"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>Bảng đánh giá xếp loại các bộ phận</h1>
                    </div>
                    <group>
                        <field name="period_id" string="Chu kỳ" required="1"/>
                    </group>

                    <separator string="Xếp loại theo bộ phận"/>
                    <field name="line_ids" readonly="1">
                        <list string="Xếp loại" create="0" delete="0">
                            <field name="department_name" string="Bộ phận"/>
                            <field name="performance_result" string="Performance Result"
                                   widget="badge"
                                   decoration-success="performance_result in ('a_plus', 'a')"
                                   decoration-info="performance_result == 'b'"
                                   decoration-warning="performance_result == 'c'"
                                   decoration-danger="performance_result == 'd'"/>
                            <field name="count" string="Tổng số"/>
                            <field name="percentage" string="Tỷ lệ (%)" widget="float"/>
                        </list>
                    </field>

                    <separator string="Danh sách MSC chờ phê duyệt (Quản lý đã duyệt)"/>
                    <field name="pending_ids" readonly="1">
                        <list string="Chờ phê duyệt" create="0" delete="0">
                            <field name="employee_id" string="Nhân viên"/>
                            <field name="department_id" string="Bộ phận"/>
                            <field name="report_to_id" string="Quản lý"/>
                            <field name="total_score" string="Tổng điểm"/>
                            <field name="performance_rating" string="Xếp loại tạm thời"
                                   widget="badge"
                                   decoration-success="performance_rating in ('a_plus', 'a')"
                                   decoration-info="performance_rating == 'b'"
                                   decoration-warning="performance_rating == 'c'"
                                   decoration-danger="performance_rating == 'd'"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ── Action: open dashboard (creates new transient) ───────────────── -->
    <record id="action_msc_bul_dashboard" model="ir.actions.act_window">
        <field name="name">Bảng đánh giá xếp loại bộ phận</field>
        <field name="res_model">msc.bul.dashboard</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
        <field name="view_id" ref="view_msc_bul_dashboard_form"/>
    </record>
</odoo>
