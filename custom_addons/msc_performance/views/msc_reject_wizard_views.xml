<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_msc_reject_wizard_form" model="ir.ui.view">
        <field name="name">msc.reject.wizard.form</field>
        <field name="model">msc.reject.wizard</field>
        <field name="arch" type="xml">
            <form string="Từ chối / Hủy phê duyệt">
                <group>
                    <field name="reject_type" readonly="1" widget="radio"/>
                    <field name="record_ids" widget="many2many_tags" readonly="1"/>
                    <field name="reason" placeholder="Nhập lý do..."/>
                </group>
                <footer>
                    <button name="action_confirm" string="Xác nhận" type="object"
                            class="btn-primary"/>
                    <button string="Hủy" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
