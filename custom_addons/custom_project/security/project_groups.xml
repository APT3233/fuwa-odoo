<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Thêm role "Quản lý" (sequence=15) vào Project privilege.
        - Người dùng (seq=10):  chỉ xem "Nhiệm vụ của tôi", không tạo/sửa task
        - Quản lý    (seq=15):  tạo task, gắn assign, sửa, xem Tất cả / Báo cáo / Dự án
        - Quản trị viên (seq=20): full access
    -->
    <record id="group_project_manager_custom" model="res.groups">
        <field name="name">Quản lý</field>
        <field name="privilege_id" ref="project.res_groups_privilege_project"/>
        <field name="sequence">15</field>
        <field name="implied_ids" eval="[(4, ref('project.group_project_user'))]"/>
        <field name="comment">Quản lý dự án — tạo/sửa task, xem Tất cả nhiệm vụ, Báo cáo, Dự án.</field>
    </record>

    <!-- Quản trị viên implies Quản lý (chain: Admin → Quản lý → Người dùng) -->
    <record id="project.group_project_manager" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_project_manager_custom'))]"/>
    </record>

    <!--
        Hạn chế quyền tạo/xóa task cho group_project_user (Người dùng).
        Giữ write=True để kéo personal stage trong "Nhiệm vụ của tôi" vẫn hoạt động.
        create=False và unlink=False: không thể tạo task mới hoặc xóa task.
    -->
    <!-- Override group_project_user: read+write only (no create/delete) -->
    <record id="project.access_project_task" model="ir.model.access">
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!--
        project_todo grants base.group_user (ALL users) full create/write/delete on project.task.
        Override to read+write only — prevents Người dùng from creating personal to-do tasks.
        write=True is kept so personal stage dragging still works.
    -->
    <record id="project_todo.access_task_on_partner" model="ir.model.access">
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!--
        Override Odoo's project_public_members_rule to also allow access when the user
        has at least one assigned task in the project. This enables Nhân viên to navigate
        to /project/<id>/tasks even if they are not a follower.
        Original rule only allowed: privacy=employees/portal OR is a follower.
        New rule adds: OR has assigned tasks.
    -->
    <record id="project.project_public_members_rule" model="ir.rule">
        <field name="domain_force">['|',
            '|',
                ('privacy_visibility', 'in', ['employees', 'portal']),
                ('message_partner_ids', 'in', [user.partner_id.id]),
            ('task_ids.user_ids', 'in', [user.id])
        ]</field>
    </record>
</odoo>
