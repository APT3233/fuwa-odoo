<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Action: Lưu trữ — chỉ hiện task có state = 1_done -->
    <record id="action_project_task_archive" model="ir.actions.act_window">
        <field name="name">Lưu trữ</field>
        <field name="res_model">project.task</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state', '=', '1_done')]</field>
        <field name="context">{
            'search_default_state': 0,
            'default_state': '1_done',
        }</field>
    </record>

    <!-- Menu: Lưu trữ — dưới mục Dự án, chỉ Quản lý trở lên -->
    <record id="menu_project_task_archive" model="ir.ui.menu">
        <field name="name">Lưu trữ</field>
        <field name="parent_id" ref="project.menu_project_management"/>
        <field name="action" ref="action_project_task_archive"/>
        <field name="sequence">30</field>
        <field name="group_ids" eval="[(6, 0, [ref('custom_project.group_project_manager_custom')])]"/>
    </record>
</odoo>
