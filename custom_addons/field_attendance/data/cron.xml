<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ir_cron_auto_checkout_midnight" model="ir.cron">
        <field name="name">Field Attendance: Tự động checkout ca chưa đóng</field>
        <field name="model_id" ref="hr_attendance.model_hr_attendance"/>
        <field name="state">code</field>
        <field name="code">model._cron_auto_checkout_midnight()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <!-- 17:05 UTC = 00:05 GMT+7 -->
        <field name="nextcall" eval="(DateTime.now().replace(hour=17, minute=5, second=0, microsecond=0)).strftime('%Y-%m-%d %H:%M:%S')"/>
        <field name="active" eval="True"/>
        <field name="user_id" ref="base.user_root"/>
    </record>
</odoo>
