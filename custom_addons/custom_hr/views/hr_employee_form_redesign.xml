<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="custom_hr_employee_form_redesign" model="ir.ui.view">
        <field name="name">custom.hr.employee.form.redesign</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="priority" eval="90"/>
        <field name="arch" type="xml">
            <!-- Header business context -->
            <xpath expr="//div[hasclass('oe_title')]/h1" position="after">
                <div class="custom_hr_header_context">
                    <div class="custom_hr_role_line">
                        <field name="job_title" placeholder="Backend Developer"/>
                        <span class="custom_hr_sep"> | </span>
                        <field name="department_id" placeholder="Phòng IT"/>
                    </div>
                    <div class="custom_hr_status_line">
                        <field name="employment_status" widget="statusbar" class="custom_hr_status_widget" options="{'clickable': False}"/>
                        <span class="custom_hr_sep"> | </span>
                        <field name="employment_type"/>
                    </div>
                    <div class="custom_hr_meta_line">
                        <span class="custom_hr_meta_label">Quản lý:</span>
                        <field name="parent_id" widget="many2one_avatar_employee"/>
                        <span class="custom_hr_meta_label ms-3">Ngày vào:</span>
                        <field name="join_date" help="Ngày bắt đầu làm việc chính thức"/>
                    </div>
                    <div class="custom_hr_contact_line">
                        <span class="custom_hr_contact_item">
                            <i class="fa fa-envelope"></i>
                            <field name="work_email" widget="email" placeholder="vd. nguyenvana@congty.com" string="Email công việc"/>
                        </span>
                        <span class="custom_hr_contact_sep">|</span>
                        <span class="custom_hr_contact_item">
                            <i class="fa fa-phone"></i>
                            <field name="work_phone" widget="phone" placeholder="Điện thoại bàn" string="Điện thoại bàn"/>
                        </span>
                        <span class="custom_hr_contact_sep">|</span>
                        <span class="custom_hr_contact_item">
                            <i class="fa fa-mobile"></i>
                            <field name="mobile_phone" widget="phone" placeholder="Di động" string="Di động"/>
                        </span>
                    </div>
                </div>
            </xpath>

            <!-- Quick actions -->
            <xpath expr="//div[hasclass('d-flex') and hasclass('flex-column') and hasclass('flex-sm-row') and hasclass('align-items-center')]" position="after">
                <div class="custom_hr_quick_actions">
                    <button name="action_open_transfer_department" type="object" string="Chuyển phòng ban" class="btn btn-outline-secondary" groups="hr.group_hr_user"/>
                    <button name="action_open_change_manager" type="object" string="Đổi quản lý" class="btn btn-outline-secondary" groups="hr.group_hr_user"/>
                    <button name="action_open_terminate_employee" type="object" string="Nghỉ việc" class="btn btn-outline-danger" groups="hr.group_hr_manager"/>
                </div>
            </xpath>

            <!-- Rename Work tab and add Overview tab -->
            <xpath expr="//notebook/page[@name='work_information']" position="attributes">
                <attribute name="string">Công việc</attribute>
            </xpath>
            <xpath expr="//notebook/page[@name='work_information']" position="before">
                <page name="overview" string="Tổng quan">
                    <div class="row custom_hr_overview">
                        <div class="col-lg-7 d-flex flex-column">
                            <group string="Thông tin chức vụ">
                                <field name="department_id" readonly="1"/>
                                <field name="job_title" readonly="1"/>
                                <field name="parent_id" widget="many2one_avatar_employee" readonly="1"/>
                            </group>
                            <group string="Thông tin nhân sự">
                                <field name="employment_status" widget="statusbar" options="{'clickable': False}" readonly="1"/>
                                <field name="employment_type" readonly="1"/>
                                <field name="join_date" readonly="1"/>
                            </group>
                            <group string="Thâm niên">
                                <field name="service_duration_years" string="Số năm" readonly="1"/>
                                <field name="service_duration_months" string="Số tháng" readonly="1"/>
                            </group>
                        </div>
                        <div class="col-lg-5">
                            <div id="custom_hr_org_chart_overview" class="o_hr_column custom_hr_org_chart"></div>
                        </div>
                    </div>
                </page>
            </xpath>

            <!-- Move org chart widget to Overview (single instance to avoid partial rendering) -->
            <xpath expr="//div[@id='custom_hr_org_chart_overview']" position="inside">
                <xpath expr="//div[@id='o_employee_org_chart']" position="move"/>
            </xpath>

            <!-- Remove old header contact lines to reduce density -->
            <xpath expr="//field[@name='work_email']/ancestor::h5" position="replace"/>
            <xpath expr="//field[@name='work_phone']/ancestor::h5" position="replace"/>
            <xpath expr="//field[@name='mobile_phone']/ancestor::h5" position="replace"/>
            <xpath expr="//field[@name='category_ids']/ancestor::h5" position="replace"/>

            <!-- Restructure Work tab -->
            <xpath expr="//div[@id='o_work_information']" position="replace">
                <div id="o_work_information" class="o_hr_column col-lg-7 d-flex flex-column custom_hr_work_information">
                    <group string="Thông tin công việc">
                        <field name="company_id" groups="base.group_multi_company" domain="[('id', 'in', allowed_company_ids)]"/>
                        <field name="department_id"/>
                        <field name="job_id" string="Vị trí công việc" context="{'default_no_of_recruitment': 0, 'default_is_favorite': False}" placeholder="vd. Trưởng phòng kinh doanh"/>
                        <field name="job_title"/>
                        <field name="parent_id" widget="many2one_avatar_employee"/>
                    </group>
                    <group string="Thông tin làm việc">
                        <field name="address_id"
                               context="{'show_address': 1}"
                               options='{"highlight_first_line": True}'/>
                        <field name="work_location_id"
                               context="{'default_address_id': address_id}"
                               placeholder="vd. Tòa nhà B, Làm từ xa..."/>
                        <field name="resource_calendar_id"/>
                    </group>
                    <group string="Liên hệ công việc">
                        <field name="work_email" widget="email" placeholder="vd. nguyenvana@congty.com" string="Email công việc"/>
                        <field name="work_phone" widget="phone" placeholder="Điện thoại bàn" string="Điện thoại bàn"/>
                        <field name="mobile_phone" widget="phone" placeholder="Di động" string="Di động"/>
                    </group>
                    <group name="departure" string="Thông tin nghỉ việc" invisible="active">
                        <field name="departure_reason_id" options="{'no_edit': True, 'no_create': True, 'no_open': True}"/>
                        <field name="departure_description"/>
                        <field name="departure_date"/>
                    </group>
                    <group string="Ghi chú" name="note" groups="hr.group_hr_user">
                        <field name="additional_note" placeholder="Ghi chú thêm về nhân viên này..." colspan="2" nolabel="1"/>
                    </group>
                </div>
            </xpath>
        </field>
    </record>

    <record id="custom_hr_employee_form_tab_order" model="ir.ui.view">
        <field name="name">custom.hr.employee.form.tab.order</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="priority" eval="95"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook/page[@name='resume']" position="before">
                <xpath expr="//notebook/page[@name='personal_information']" position="move"/>
            </xpath>
        </field>
    </record>
</odoo>
