<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tab Tài khoản ngân hàng -->
    <record id="custom_hr_employee_bank_tab" model="ir.ui.view">
        <field name="name">custom.hr.employee.bank.tab</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="priority" eval="92"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page name="bank_info" string="Tài khoản NH" groups="hr.group_hr_user">
                    <field name="custom_bank_account_ids" nolabel="1">
                        <list editable="bottom">
                            <field name="bank_name" string="Tên ngân hàng"/>
                            <field name="bank_branch" string="Chi nhánh"/>
                            <field name="account_number" string="Số tài khoản"/>
                            <field name="account_holder" string="Chủ tài khoản"/>
                            <field name="is_primary" string="Tài khoản chính"/>
                            <field name="note" string="Ghi chú"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
