<?xml version="1.0" encoding="utf-8"?>
<!--
    Priority 120 — Vietnamese labels: tabs, groups, stat buttons
    ─────────────────────────────────────────────────────────────
    Chỉ chứa các nhãn CƠ BẢN không có label phụ thuộc vào cấu trúc deep.
    Labels chi tiết hơn (personal tab fields, OCA form/search labels) nằm trong
    hr_employee_vn_labels_deep.xml (priority 125).

    Đã loại bỏ các record duplicate với _deep.xml:
      - documents stat button      → xem _deep: custom_hr_employee_vn_labels_documents_deep
      - documents public stat btn  → xem _deep: custom_hr_employee_vn_labels_documents_public_deep
      - medical stat button        → xem _deep: custom_hr_employee_vn_labels_medical_deep
-->
<odoo>
    <!-- Core HR: đổi tên tabs + groups trong Personal tab -->
    <record id="custom_hr_employee_vn_labels_core" model="ir.ui.view">
        <field name="name">custom.hr.employee.vn.labels.core</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="priority" eval="120"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook/page[@name='resume']" position="attributes">
                <attribute name="string">CV</attribute>
            </xpath>
            <xpath expr="//notebook/page[@name='personal_information']" position="attributes">
                <attribute name="string">Cá nhân</attribute>
            </xpath>
            <xpath expr="//group[@name='hr_birth_group']" position="attributes">
                <attribute name="string">Thông tin cá nhân</attribute>
            </xpath>
            <xpath expr="//group[.//field[@name='visa_no'] and .//field[@name='permit_no']]"
                   position="attributes">
                <attribute name="string">Visa &amp; Giấy phép lao động</attribute>
            </xpath>
            <xpath expr="//group[@name='hr_document_group']" position="attributes">
                <attribute name="string">Tài liệu</attribute>
            </xpath>
        </field>
    </record>

    <!-- HR Attendance: nút "Monthly Hours" → "Giờ làm tháng" -->
    <record id="custom_hr_employee_vn_labels_attendance" model="ir.ui.view">
        <field name="name">custom.hr.employee.vn.labels.attendance</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr_attendance.view_employee_form_inherit_hr_attendance"/>
        <field name="priority" eval="120"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_open_last_month_attendances']//span[hasclass('o_stat_text')]"
                   position="replace">
                <span class="o_stat_text">Giờ làm tháng</span>
            </xpath>
        </field>
    </record>

    <!-- OCA hr_employee_relative: tab "Relatives" → "Người thân" -->
    <record id="custom_hr_employee_vn_labels_relatives" model="ir.ui.view">
        <field name="name">custom.hr.employee.vn.labels.relatives</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr_employee_relative.hr_employee_view_form"/>
        <field name="priority" eval="120"/>
        <field name="arch" type="xml">
            <!-- Selector qua field bên trong (Odoo 19 không cho dùng @string làm selector) -->
            <xpath expr="//field[@name='relative_ids']/.." position="attributes">
                <attribute name="string">Người thân</attribute>
            </xpath>
        </field>
    </record>
</odoo>
