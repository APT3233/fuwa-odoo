<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_custom_hr_change_manager_wizard" model="ir.ui.view">
        <field name="name">custom.hr.change.manager.wizard.form</field>
        <field name="model">custom_hr.change.manager.wizard</field>
        <field name="arch" type="xml">
            <form string="Đổi quản lý">
                <group>
                    <field name="employee_id" readonly="1"/>
                    <field name="manager_id"/>
                </group>
                <footer>
                    <button string="Xác nhận" type="object" name="action_confirm" class="btn btn-primary"/>
                    <button string="Hủy" special="cancel" class="btn btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
