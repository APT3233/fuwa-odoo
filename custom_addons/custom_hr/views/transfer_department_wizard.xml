<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_custom_hr_transfer_department_wizard" model="ir.ui.view">
        <field name="name">custom.hr.transfer.department.wizard.form</field>
        <field name="model">custom_hr.transfer.department.wizard</field>
        <field name="arch" type="xml">
            <form string="Chuyển phòng ban">
                <group>
                    <field name="employee_id" readonly="1"/>
                    <field name="department_id"/>
                    <field name="effective_date"/>
                    <field name="decision_number"/>
                    <field name="note"/>
                </group>
                <footer>
                    <button string="Xác nhận" type="object" name="action_confirm" class="btn btn-primary"/>
                    <button string="Hủy" special="cancel" class="btn btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
