<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_custom_hr_terminate_employee_wizard" model="ir.ui.view">
        <field name="name">custom.hr.terminate.employee.wizard.form</field>
        <field name="model">custom_hr.terminate.employee.wizard</field>
        <field name="arch" type="xml">
            <form string="Xác nhận nghỉ việc">
                <group>
                    <field name="employee_id" readonly="1"/>
                    <field name="departure_reason_id" options="{'no_create': True, 'no_open': True}"/>
                    <field name="departure_date"/>
                    <field name="departure_description" placeholder="Ghi chú thêm (nếu có)..."/>
                </group>
                <footer>
                    <button string="Xác nhận nghỉ việc" type="object" name="action_confirm" class="btn btn-danger"/>
                    <button string="Hủy" special="cancel" class="btn btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
