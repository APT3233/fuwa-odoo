<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Thêm field ZKTeco PIN vào tab Cài đặt HR của form nhân viên -->
    <record id="hr_employee_view_form_zkteco" model="ir.ui.view">
        <field name="name">hr.employee.form.zkteco.pin</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='barcode']" position="after">
                <field name="zkteco_pin" string="PIN máy ZKTeco"/>
            </xpath>
        </field>
    </record>
</odoo>
