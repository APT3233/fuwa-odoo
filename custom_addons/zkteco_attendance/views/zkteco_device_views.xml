<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="zkteco_device_view_form" model="ir.ui.view">
        <field name="name">zkteco.device.form</field>
        <field name="model">zkteco.device</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state" widget="statusbar"
                        statusbar_visible="waiting,connected"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" name="action_view_logs"
                            type="object" icon="fa-list">
                            <field name="log_count" widget="statinfo" string="Logs"/>
                        </button>
                        <button class="oe_stat_button" name="action_view_attendances"
                            type="object" icon="fa-clock-o">
                            <field name="attendance_count" widget="statinfo" string="Chấm công"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Tên máy..."/></h1>
                    </div>
                    <group>
                        <group string="Thông tin máy">
                            <field name="serial_number" readonly="1"
                                placeholder="Tự động điền khi máy kết nối"/>
                            <field name="location"/>
                            <field name="last_activity" readonly="1"/>
                        </group>
                        <group string="Xác thực">
                            <field name="token" password="True"
                                placeholder="Để trống = không yêu cầu token"/>
                            <button name="action_generate_token" type="object"
                                string="Tạo token ngẫu nhiên" class="btn btn-secondary btn-sm"/>
                        </group>
                    </group>
                    <group string="Hướng dẫn cấu hình máy ZKTeco">
                        <div class="alert alert-info" role="alert">
                            <p><strong>Cấu hình trên máy ZKTeco SenseFace 4A:</strong></p>
                            <ol>
                                <li>Vào <strong>Menu → Communication → ADMS</strong></li>
                                <li>Bật <strong>Enable ADMS</strong></li>
                                <li>Nhập <strong>Server Address</strong>: <code>103.37.60.195</code></li>
                                <li>Nhập <strong>Server Port</strong>: <code>8069</code></li>
                                <li>Nhập <strong>HTTPS</strong>: <strong>Tắt</strong></li>
                                <li>Cấu hình <strong>Gateway</strong> trong phần Ethernet thành IP router (ví dụ: <code>192.168.1.1</code>)</li>
                                <li>Lưu và khởi động lại máy</li>
                            </ol>
                            <p>Máy sẽ tự kết nối và tạo device record tại đây.</p>
                        </div>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="zkteco_device_view_list" model="ir.ui.view">
        <field name="name">zkteco.device.list</field>
        <field name="model">zkteco.device</field>
        <field name="arch" type="xml">
            <list string="Máy chấm công ZKTeco">
                <field name="name"/>
                <field name="serial_number"/>
                <field name="location"/>
                <field name="last_activity"/>
                <field name="log_count"/>
                <field name="state" widget="badge"
                    decoration-success="state == 'connected'"
                    decoration-warning="state == 'waiting'"
                    decoration-danger="state == 'error'"/>
            </list>
        </field>
    </record>

    <record id="action_zkteco_device" model="ir.actions.act_window">
        <field name="name">Máy chấm công ZKTeco</field>
        <field name="res_model">zkteco.device</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
