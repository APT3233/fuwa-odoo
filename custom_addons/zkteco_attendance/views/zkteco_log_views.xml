<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="zkteco_log_view_list" model="ir.ui.view">
        <field name="name">zkteco.attendance.log.list</field>
        <field name="model">zkteco.attendance.log</field>
        <field name="arch" type="xml">
            <list string="Log chấm công ZKTeco"
                decoration-danger="state == 'error'"
                decoration-muted="state == 'ignored'"
                decoration-success="state == 'processed'">
                <field name="punch_time"/>
                <field name="device_id"/>
                <field name="pin"/>
                <field name="employee_id"/>
                <field name="punch_type"/>
                <field name="attendance_id"/>
                <field name="state" widget="badge"
                    decoration-success="state == 'processed'"
                    decoration-warning="state == 'new'"
                    decoration-danger="state == 'error'"
                    decoration-info="state == 'ignored'"/>
                <field name="error_msg" optional="show"/>
            </list>
        </field>
    </record>

    <record id="zkteco_log_view_form" model="ir.ui.view">
        <field name="name">zkteco.attendance.log.form</field>
        <field name="model">zkteco.attendance.log</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_reprocess" type="object"
                        string="Xử lý lại"
                        invisible="state not in ('error', 'ignored')"
                        class="btn-primary"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="device_id"/>
                            <field name="pin"/>
                            <field name="employee_id"/>
                            <field name="punch_time"/>
                            <field name="punch_type"/>
                        </group>
                        <group>
                            <field name="attendance_id"/>
                            <field name="error_msg" invisible="state != 'error'"/>
                        </group>
                    </group>
                    <field name="raw_data" readonly="1"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="zkteco_log_view_search" model="ir.ui.view">
        <field name="name">zkteco.attendance.log.search</field>
        <field name="model">zkteco.attendance.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="pin"/>
                <field name="employee_id"/>
                <field name="device_id"/>
                <filter string="Mới" name="new" domain="[('state','=','new')]"/>
                <filter string="Lỗi" name="error" domain="[('state','=','error')]"/>
                <filter string="Đã xử lý" name="processed" domain="[('state','=','processed')]"/>
                <separator/>
                <filter string="Hôm nay" name="today"
                    domain="[('punch_time','&gt;=', (context_today()).strftime('%Y-%m-%d 00:00:00'))]"/>
                <separator/>
                <filter string="Nhân viên" name="group_employee" context="{'group_by':'employee_id'}"/>
                <filter string="Máy" name="group_device" context="{'group_by':'device_id'}"/>
                <filter string="Ngày" name="group_date" context="{'group_by':'punch_time:day'}"/>
            </search>
        </field>
    </record>

    <record id="action_zkteco_log" model="ir.actions.act_window">
        <field name="name">Log chấm công ZKTeco</field>
        <field name="res_model">zkteco.attendance.log</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_error': 0}</field>
    </record>
</odoo>
