<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Extend employee form to show ZKTeco PIN field -->
    <record id="hr_employee_view_form_zkteco" model="ir.ui.view">
        <field name="name">hr.employee.form.zkteco</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='identification_group']" position="inside">
                <field name="zkteco_pin" groups="hr.group_hr_user"/>
            </xpath>
        </field>
    </record>
</odoo>
