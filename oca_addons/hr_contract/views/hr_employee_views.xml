<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_employee_contract_inherit" model="ir.ui.view">
        <field name="name">hr.employee.contract.inherit</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button class="oe_stat_button" name="action_open_contracts" type="object"
                    icon="fa-sign-language" groups="hr.group_hr_user"
                    invisible="contracts_count == 0">
                    <field name="contracts_count" widget="statinfo" string="Contracts"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
